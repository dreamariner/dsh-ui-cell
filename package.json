{
  "name": "@dreamariner/dsh-ui-cell",
  "description": "DSH 插件专用的 shadcn 式 UI 组件框架：组件源码复制进插件、类名带插件前缀、样式只引用 --dsw-alias-* token",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "dsh-ui-cell": "./lib/cli.mjs"
  },
  "files": [
    "lib",
    "src",
    "registry.json",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "vendor": "node scripts/vendor-tokens.mjs",
    "vendor:check": "node scripts/vendor-tokens.mjs --check",
    "prepare": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ui",
    "components",
    "shadcn",
    "cordis",
    "plugin"
  ],
  "author": "Jianan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreamariner/dsh-ui-cell.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@shikijs/langs": "4.4.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/unist": "^3.0.3",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "katex": "^0.18.10",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.4.3",
    "tsdown": "^0.22.2",
    "typescript": "^5.9",
    "vitest": "^5.0.3"
  }
}
